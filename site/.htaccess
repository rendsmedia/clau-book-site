# Always use https (removes the browser's "Not secure" warning on http:// visits)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# STAGING ONLY: tell search engines not to index anything on this subdomain.
# Remove this block (and the robots meta in index.html) to go public.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
