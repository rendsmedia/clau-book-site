# Never show folder listings
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for everything: https://williammatovu.com (no www, no http)
  # (cPanel's SSL checks in /.well-known/ are left alone so certificates keep renewing)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} !^williammatovu\.com$ [NC]
  RewriteRule ^ https://williammatovu.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://williammatovu.com%{REQUEST_URI} [L,R=301]

  # Clean page addresses: /contact serves contact.html, and /contact.html redirects to /contact
  RewriteCond %{THE_REQUEST} \s/+(index)\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Keep the contact handler's error page and 404 out of search results
<IfModule mod_headers.c>
  <FilesMatch "^(404\.html|contact\.php)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# Pages are always re-checked so updates show at once; CSS/JS are versioned (?v=) on each deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

